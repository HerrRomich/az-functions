{
  "name": "@herrromich/az-functions-monorepo",
  "description": "Monorepo for Extensions of NodeJS Azure Functions",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:all": "run build:recursive",
    "watch:all": "yarn workspaces foreach --all --parallel --interlaced  run watch:recursive",
    "lint:all": "yarn workspaces foreach --all --parallel --interlaced  run lint",
    "test:all": "yarn workspaces foreach --all --parallel --interlaced  run test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@azure/functions": "catalog:",
    "@opentelemetry/context-async-hooks": "^2.2.0",
    "inversify": "catalog:",
    "kysely": "catalog:",
    "winston": "catalog:",
    "winston-transport": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@angular/cli": "catalog:",
    "@eslint/eslintrc": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "babel-jest": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "eslint-plugin-json": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "jest": "catalog:",
    "globals": "catalog:",
    "gts": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "terser-webpack-plugin": "catalog:",
    "tsconfig-paths": "catalog:",
    "tsconfig-paths-webpack-plugin": "catalog:",
    "ts-jest": "catalog:",
    "ts-loader": "catalog:",
    "source-map-loader": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "catalog:"
  },
  "packageManager": "pnpm@10.24.0"
}
