{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.18.0",
    "storageDir": ".openapi-generator-releases",
    "generators": {
      "admin-center-api": {
        "templateDir": "./tools/openapi-generator/templates",
        "generatorName": "typescript-angular",
        "output": "./src/app/shared/apis/backend",
        "glob": "./node_modules/@herrromich/az-functionsexample-backend/dist/open-api-definitions/console-api.json",
        "additionalProperties": {
          "ngVersion": "20.0.0",
          "taggedUnions": true,
          "stringEnums": false,
          "enumPropertyNaming": "original",
          "legacyDiscriminatorBehavior": true,
          "providedIn": "none"
        }
      }
    }
  }
}
