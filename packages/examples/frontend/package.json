{
  "name": "example-frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dist:clean": "rimraf ./dist",
    "deploy": "pnpm swa deploy frontend --env Production -nu",
    "dist:assemble": "pnpm run dist:clean && pnpm run dist:build",
    "dist:build": "(pnpm run dist:clean & pnpm run '/api:remove-generate:.*/') && pnpm build",
    "start": "pnpm run '/api:remove-generate:.*/' && (pnpm run '/api:watch:.*/' & ng serve)",
    "build": "ng build --configuration development",
    "watch": "pnpm run '/api:remove-generate:.*/' && (pnpm run '/api:watch:.*/' & & ng build --watch --configuration development)",
    "test": "jest --env=node --colors --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src ",
    "api:remove-generate:console": "pnpm run api:remove:console && pnpm run api:generate:console",
    "api:remove:console": "rimraf './src/app/shared/apis/backend/**/{*.*, !.openapi-generator-ignore}' -g",
    "api:watch:console": "chokidar './node_modules/example-backend/dist/open-api-definitions/console-api.json' --initial -c 'pnpm run api:generate:console'",
    "api:generate:console": "openapi-generator-cli generate && prettier ./src/app/shared/apis/*/** --write",
    "proxy": "swa start http://localhost:4200 --api-location http://127.0.0.1:7071",
    "ci:build": "pnpm dist:build"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/google-maps": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@azure/msal-angular": "catalog:",
    "@azure/msal-browser": "catalog:",
    "@ngrx/signals": "^22.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "example-security": "workspace:*",
    "jwt-decode": "catalog:",
    "lodash-es": "^4.17.23",
    "ol": "^10.8.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.4.0",
    "@angular-eslint/eslint-plugin": "22.4.0",
    "@angular-eslint/eslint-plugin-template": "22.4.0",
    "@angular-eslint/schematics": "22.4.0",
    "@angular-eslint/template-parser": "22.4.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@azure/static-web-apps-cli": "catalog:",
    "@babel/preset-env": "catalog:",
    "@eslint/js": "catalog:",
    "@mdi/angular-material": "^7.2.96",
    "@mdi/font": "catalog:",
    "@openapitools/openapi-generator-cli": "catalog:",
    "@types/geojson": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash-es": "^4.17.12",
    "7zip-bin": "catalog:",
    "angular-eslint": "22.4.0",
    "chokidar-cli": "^2.1.0",
    "eslint": "catalog:",
    "example-backend": "workspace:*",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "catalog:",
    "jest-environment-jsdom": "^30.3.0",
    "jest-extended": "catalog:",
    "jest-mock-extended": "catalog:",
    "jest-preset-angular": "^16.2.0",
    "rimraf": "catalog:",
    "ts-jest": "catalog:",
    "type-fest": "catalog:",
    "typescript": "~6.0.3",
    "typescript-eslint": "catalog:"
  }
}
