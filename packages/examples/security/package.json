{
  "name": "example-security",
  "version": "0.0.1",
  "main": "dist/index.cjs",
  "types": "dist/src/index.d.ts",
  "private": true,
  "scripts": {
    "dist:clean": "rimraf ./dist",
    "dist:assemble": "pnpm run dist:build",
    "dist:build": "pnpm run dist:clean && webpack --mode=production",
    "build:recursive": "pnpm -r --sort --filter {.}... run dist:build",
    "watch": "webpack --mode=development --watch",
    "watch:recursive": "pnpm -r --sort --filter {.}... --parallel --stream run watch",
    "test": "jest --env=node --colors --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "ci:build": "pnpm lint && pnpm test && pnpm dist:build"
  },
  "dependencies": {
    "@herrromich/az-functions": "workspace:*"
  },
  "devDependencies": {
    "@babel/preset-env": "catalog:",
    "@types/eslint": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "jest-extended": "catalog:",
    "jest-mock-extended": "catalog:",
    "rimraf": "catalog:",
    "source-map-loader": "catalog:",
    "ts-jest": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-bundle-analyzer": "catalog:",
    "webpack-node-externals": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
