{{#stringEnums}}
  export enum {{classname}} {
  {{#allowableValues}}
    {{#enumVars}}
      {{name}} = {{{value}}}{{^-last}},{{/-last}}
    {{/enumVars}}
  {{/allowableValues}}
    }
{{/stringEnums}}
{{^stringEnums}}
  export const {{classname}} = [{{#allowableValues}}{{#enumVars}}{{{value}}}{{^-last}},  {{/-last}}{{/enumVars}}{{/allowableValues}}] as const;
  export type {{classname}} = typeof {{classname}}[number];

{{/stringEnums}}
