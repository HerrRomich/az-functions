{
  "name": "@herrromich/transaction-manager",
  "version": "1.0.1",
  "license": "MIT",
  "description": "Declarative transaction management for Kysely using decorators and AsyncLocalStorage.",
  "main": "dist/index.cjs",
  "types": "dist/src/index.d.ts",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dist:clean": "rimraf ./dist",
    "dist:assemble": "pnpm run dist:build",
    "dist:build": "pnpm dist:clean && webpack --mode=production",
    "dist:build:recursive": "pnpm -r --sort --filter {.}... run dist:build",
    "watch": "webpack --mode=development --watch",
    "watch:recursive": "pnpm -r --sort --filter {.}... --parallel --stream run watch",
    "test": "jest --env=node --colors --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "ci:build": "pnpm lint && pnpm test && pnpm dist:build",
    "ci:build:recursive": "pnpm -r --sort --filter {.}... run ci:build"
  },
  "dependencies": {
    "reflect-metadata": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@types/eslint": "catalog:",
    "@types/jest": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "jest-extended": "catalog:",
    "jest-mock-extended": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-node-externals": "catalog:"
  },
  "peerDependencies": {
    "kysely": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HerrRomich/az-functions.git",
    "directory": "packages/extensions/transaction-manager"
  },
  "bugs": {
    "url": "https://github.com/HerrRomich/az-functions/issues"
  },
  "homepage": "https://github.com/HerrRomich/az-functions/tree/main/packages/extensions/transaction-manager"
}
