{
  "name": "@herrromich/az-functions-monorepo",
  "description": "Monorepo for Extensions of NodeJS Azure Functions",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dist:clean": "pnpm -r --parallel --sort --stream run dist:clean",
    "dist:build": "pnpm -r --parallel --sort --stream run dist:build",
    "watch": "pnpm -r --parallel --stream watch",
    "lint": "pnpm  -r --parallel --stream lint",
    "test": "pnpm -r --parallel --stream test",
    "infra:deploy": "pnpm --filter infra run deploy",
    "frontend:deploy": "pnpm --filter example-frontend run deploy",
    "dist:assemble": "pnpm -r --parallel --sort --stream run dist:assemble",
    "deploy": "pnpm run dist:assemble && pnpm run infra:deploy && pnpm run frontend:deploy",
    "ci:build": "pnpm -r --parallel --sort --stream run ci:build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "catalog:",
    "@eslint/js": "catalog:",
    "@rollup/plugin-alias": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-json": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typia/unplugin": "catalog:",
    "babel-jest": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-json": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "globals": "catalog:",
    "gts": "catalog:",
    "jest": "catalog:",
    "jsonc-eslint-parser": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "rollup-plugin-tsconfig-paths": "catalog:",
    "source-map-loader": "catalog:",
    "terser-webpack-plugin": "catalog:",
    "ts-jest": "catalog:",
    "ts-loader": "catalog:",
    "ts-patch": "catalog:",
    "tsconfig-paths": "catalog:",
    "tsconfig-paths-webpack-plugin": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "catalog:"
  },
  "packageManager": "pnpm@10.30.3"
}
