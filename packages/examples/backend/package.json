{
  "name": "example-backend",
  "version": "0.0.1",
  "main": "dist/index.cjs",
  "types": "dist/src/index.d.ts",
  "private": true,
  "scripts": {
    "dist:clean": "rimraf ./dist",
    "dist:assemble": "pnpm run dist:build && pnpm run dist:pack",
    "dist:pack": "node ./scripts/assemble.mjs",
    "dist:build": "pnpm run dist:clean && pnpm build",
    "build": "webpack --mode=production",
    "build:recursive": "pnpm -r --parallel --sort --filter {.}...  run dist:build",
    "watch": "webpack --mode=development --watch",
    "watch:recursive": "pnpm -r --sort --filter {.}... --parallel --stream run watch",
    "test": "jest --env=node --colors --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "start": "func start --verbose --javascript --watch",
    "swa": "swa start http://localhost:4200 --api-location http://127.0.0.1:7071",
    "ci:build": "pnpm dist:build"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@azure/event-hubs": "catalog:",
    "@azure/functions": "catalog:",
    "@azure/identity": "catalog:",
    "@forks/source-map-support": "workspace:*",
    "@herrromich/az-functions": "workspace:*",
    "@herrromich/transaction-manager": "workspace:*",
    "@redis/client": "catalog:",
    "@redis/entraid": "catalog:",
    "@turf/turf": "catalog:",
    "@utilities/test-utilities": "workspace:*",
    "example-security": "workspace:*",
    "jsonwebtoken": "catalog:",
    "jwks-rsa": "catalog:",
    "inversify": "catalog:",
    "kysely": "catalog:",
    "lodash": "catalog:",
    "openapi3-ts": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "tslib": "catalog:",
    "winston": "catalog:",
    "wkx": "catalog:",
    "zod": "catalog:",
    "zod-geojson": "catalog:"
  },
  "devDependencies": {
    "7zip-bin": "catalog:",
    "@babel/preset-env": "catalog:",
    "@types/eslint": "catalog:",
    "@types/geojson": "catalog:",
    "@types/jest": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/lodash": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "copy-webpack-plugin": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "jest-extended": "catalog:",
    "jest-mock-extended": "catalog:",
    "rimraf": "catalog:",
    "source-map-loader": "catalog:",
    "swagger-ui-dist": "catalog:",
    "ts-jest": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-bundle-analyzer": "catalog:",
    "webpack-node-externals": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
