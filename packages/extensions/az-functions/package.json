{
  "name": "@herrromich/az-functions",
  "description": "Extensions for NodeJS Azure Functions",
  "version": "1.0.0",
  "license": "MIT",
  "main": "dist/index.cjs",
  "types": "dist/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dist:clean": "rimraf ./dist",
    "dist:fix-types": "tsc-alias -p tsconfig.json --outDir dist",
    "dist:assemble": "pnpm run dist:build",
    "dist:build": "pnpm run dist:clean && webpack --mode=production && pnpm run dist:fix-types",
    "dist:build:recursive": "pnpm -r --sort --filter {.}... run dist:build",
    "watch:fix-types": "tsc-alias -p tsconfig.json --outDir dist --watch",
    "watch:webpack": "webpack --mode=development --watch",
    "watch": "pnpm run watch:webpack & pnpm run watch:fix-types",
    "watch:recursive": "pnpm -r --sort --filter {.}... --parallel --stream run watch",
    "test": "jest --env=node --colors --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "ci:build": "pnpm lint && pnpm test && pnpm dist:build",
    "ci:build:recursive": "pnpm -r --sort --filter {.}... run ci:build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry-exporter": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "http-status-codes": "catalog:",
    "lodash": "catalog:",
    "mime-types": "catalog:",
    "openapi3-ts": "catalog:",
    "swagger-ui-dist": "catalog:",
    "triple-beam": "catalog:",
    "tslib": "catalog:",
    "winston": "catalog:",
    "winston-transport": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@types/eslint": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/node": "catalog:",
    "@types/triple-beam": "catalog:",
    "copy-webpack-plugin": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "jest-extended": "catalog:",
    "jest-mock": "catalog:",
    "jest-mock-extended": "catalog:",
    "rimraf": "catalog:",
    "rollup": "catalog:",
    "source-map-loader": "catalog:",
    "syncpack": "catalog:",
    "tsc-alias": "^1.9.2",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-bundle-analyzer": "catalog:",
    "@utilities/test-utilities": "workspace:*",
    "webpack-node-externals": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@azure/functions": "catalog:",
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:HerrRomich/az-functions.git"
  }
}
