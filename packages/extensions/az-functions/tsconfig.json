{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "declaration": true,
    "types": ["node", "reflect-metadata"],
    "paths": {
      "shared": ["./src/shared"],
      "http-controller": ["./src/http-controller"],
      "context": ["./src/context"],
      "security": ["./src/security"],
      "logger": ["./src/logger"],
      "event-hub-handler": ["./src/event-hub-handler"],
      "platform": ["./src/platform"],
      "test-utilities": ["./src/test-utilities"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-utilities/**/*.ts"]
}
